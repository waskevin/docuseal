# Multilingual file for TOS 7 Docker application. All 14 languages are REQUIRED.

[en-us]
name = "DocuSeal"
auth = "waskevin"
descript = "DocuSeal is a self-hosted document signing platform. Build reusable templates from PDF or DOCX files, send them for signature and track every submission, with the data stored only on your TNAS."
release_note = "1. Initial release."
important = "DockerEngine must be installed and enabled from the TOS App Center. Docker image source: Docker Hub."

